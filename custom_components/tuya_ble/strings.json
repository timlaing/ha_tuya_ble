      "qr": {
        "description": "Scan this QR code in your Tuya Smart or Smart Life app."
      },
      "discovered_device": {
        "description": "Set up the discovered device {name} ({address}). Submit to retry the Bluetooth scan."
      },
      "unverified": {
        "title": "Add the device anyway?",
        "description": "You can still add {name} ({address}), but it may show as unavailable. Select Submit to add it, or close this window to cancel. Once added, downloading its diagnostics helps add support for it."
