    "flow_title": "{name}",
    "progress": {
      "verify_device": "Checking that Home Assistant can connect to the device over Bluetooth..."
    },
    "step": {
      "reconfigure": {
        "description": "Check the Bluetooth connection to this Tuya BLE protocol v4 device again. The device disconnects briefly during the check. Keep it close to Home Assistant and close the Smart Life app first. Your entities and settings are kept."
